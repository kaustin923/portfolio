        "climber": { "name": "GAINWELL", "label": "14", "stat": "1,023 YDS" },
        "fromIndex": 2,
        "toIndex": 1
      }
    },
    {
      "speaker": "george",
      "text": "Number four: Jonah Coleman, Denver. That backfield is wide open, and he's the most explosive guy in the room.",
