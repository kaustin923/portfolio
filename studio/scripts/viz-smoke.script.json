  "lines": [
    {
      "speaker": "jessica",
      "text": "The release rewrote the opening weekend.",
      "visual": "WRITER NOTE ONLY: DEEP-BLUE FULL-BLEED WITH HUGE WHITE TYPE AND RED SLASHES",
      "viz": {
        "kind": "title",
        "big": "THE $4.2B SHIFT",
        "sub": "A release-window reset measured in real dollars",
        "dateChip": "JUL 19 2026"
      }
    },
    {
      "speaker": "george",
      "text": "The forecast cleared the old benchmark before noon.",
      "visual": "WRITER NOTE ONLY: DRAW A RANGE AND MAKE THE OLD FORECAST GET CRUSHED",
      "viz": {
        "kind": "rangeBar",
        "label": "GLOBAL OPENING FORECAST",
        "unit": "M",
        "low": 380,
        "high": 620,
        "compare": {"label": "OLD RECORD", "value": 412},
        "badge": "+50.5% CEILING"
      }
    },
    {
      "speaker": "jessica",
      "text": "The launch still carried a measurable marketing loss.",
      "visual": "WRITER NOTE ONLY: ANGRY RED COUNTER TUMBLING THROUGH FAKE NUMBERS",
      "viz": {
        "kind": "counter",
        "label": "NET MARKETING LOSS",
        "to": -2400000,
        "prefix": "$",
        "from": 0,
        "negative": true,
        "sub": "AUDITED SPEND / OPENING WEEK"
