      "viz": {
        "kind": "statBig",
        "value": "$4B",
        "label": "GLOBAL LICENSING VALUE",
        "sub": "SIGNED / FOUR TERRITORIES / ONE QUARTER"
      }
    },
    {
      "speaker": "jessica",
      "text": "The channel mix landed above the fifty percent target.",
      "visual": "WRITER NOTE ONLY: GENERIC BAR CHART ONE TWO PACE STYLE FLOW",
      "viz": {
        "kind": "compareBars",
        "unit": "%",
